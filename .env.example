NODE_ENV=development
PORT=3000

# Postgres connection string. Leave unset to fall back to a local SQLite
# file (dev.sqlite) for quick local testing without a database server.
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow

# Use long, random values in any real deployment.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
